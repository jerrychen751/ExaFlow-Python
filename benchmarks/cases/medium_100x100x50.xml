<?xml version="1.0" encoding="utf-8"?>
  <Simulation>
    <FluidProperties>
      <Rho>1.225</Rho>
      <Nu>1.81e-5</Nu>
    </FluidProperties>
    <GridProperties>
      <Size>
        <Length>6.28</Length>
        <Width>3.14</Width>
        <Height>2</Height>
      </Size>
      <Domain>
        <nx>100</nx>
        <ny>100</ny>
        <nz>50</nz>
      </Domain>
      <nt>50</nt>
      <numGhosts>1</numGhosts>
      <CFL>0.5</CFL>
      <EndTime>-1</EndTime>
      <AdaptiveTimeStep>False</AdaptiveTimeStep>
    </GridProperties>
    <InitialConditions>
      <ReadFromVtrFile>False</ReadFromVtrFile>
      <ReadFromCsvFile>False</ReadFromCsvFile>
      <SpecifyValues>True</SpecifyValues>
      <SpecifiedValues>
        <p>
          <UseUniform>True</UseUniform>
          <UniformParameters>
            <ConstantValue>0</ConstantValue>
          </UniformParameters>
          <UseStep>True</UseStep>
          <StepParameters>
            <!-- Give the start and end as fractions (inclusive) of the total length (x), width (y), and height (z)-->
            <StepMagnitude>1</StepMagnitude>
            <startX>.25</startX>
            <endX>.75</endX>
            <startY>0</startY>
            <endY>1</endY>
            <startZ>0</startZ>
            <endZ>1</endZ>
          </StepParameters>
          <UseSinusoidal>False</UseSinusoidal>
          <UsePolynomial>False</UsePolynomial>
          <UseGaussian>False</UseGaussian>
        </p>
        <u>
          <UseUniform>True</UseUniform>
          <UniformParameters>
            <ConstantValue>2</ConstantValue>
          </UniformParameters>
          <UseStep>True</UseStep>
          <StepParameters>
            <!-- Give the start and end as fractions (inclusive) of the total length (x), width (y), and height (z)-->
            <StepMagnitude>1</StepMagnitude>
            <startX>.25</startX>
            <endX>.75</endX>
            <startY>0</startY>
            <endY>1</endY>
            <startZ>0</startZ>
            <endZ>1</endZ>
          </StepParameters>
          <UseSinusoidal>False</UseSinusoidal>
          <UsePolynomial>False</UsePolynomial>
          <UseGaussian>False</UseGaussian>
        </u>
        <v>
          <UseUniform>True</UseUniform>
          <UniformParameters>
            <ConstantValue>1</ConstantValue>
          </UniformParameters>
          <UseStep>True</UseStep>
          <StepParameters>
            <!-- Give the start and end as fractions (inclusive) of the total length (x), width (y), and height (z)-->
            <StepMagnitude>1</StepMagnitude>
            <startX>.25</startX>
            <endX>.75</endX>
            <startY>0</startY>
            <endY>1</endY>
            <startZ>0</startZ>
            <endZ>1</endZ>
          </StepParameters>
          <UseSinusoidal>False</UseSinusoidal>
          <UsePolynomial>False</UsePolynomial>
          <UseGaussian>False</UseGaussian>
        </v>
        <w>
          <UseUniform>True</UseUniform>
          <UniformParameters>
            <ConstantValue>1</ConstantValue>
          </UniformParameters>
          <UseStep>True</UseStep>
          <StepParameters>
            <!-- Give the start and end as fractions (inclusive) of the total length (x), width (y), and height (z)-->
            <StepMagnitude>1</StepMagnitude>
            <startX>.25</startX>
            <endX>.75</endX>
            <startY>0</startY>
            <endY>1</endY>
            <startZ>0</startZ>
            <endZ>1</endZ>
          </StepParameters>
          <UseSinusoidal>False</UseSinusoidal>
          <UsePolynomial>False</UsePolynomial>
          <UseGaussian>False</UseGaussian>
        </w>
      </SpecifiedValues>
    </InitialConditions>
    <BoundaryConditions>
      <LeftWall>Inflow</LeftWall>
      <LeftInflow>
        <u>2</u>
        <v>1</v>
        <w>1</w>
      </LeftInflow>
      <LeftOutflow>
        <p>0</p>
      </LeftOutflow>
      <RightWall>Outflow</RightWall>
      <RightInflow>
        <u>-1</u>
        <v>-1</v>
        <w>-1</w>
      </RightInflow>
      <RightOutflow>
        <p>0</p>
      </RightOutflow>
      <TopWall>No Slip Wall</TopWall>
      <TopInflow>
        <u>-1</u>
        <v>-1</v>
        <w>-1</w>
      </TopInflow>
      <TopOutflow>
        <p>0</p>
      </TopOutflow>
      <BottomWall>No Slip Wall</BottomWall>
      <BottomInflow>
        <u>-1</u>
        <v>-1</v>
        <w>-1</w>
      </BottomInflow>
      <BottomOutflow>
        <p>0</p>
      </BottomOutflow>
      <FrontWall>No Slip Wall</FrontWall>
      <FrontInflow>
        <u>-1</u>
        <v>-1</v>
        <w>-1</w>
      </FrontInflow>
      <FrontOutflow>
        <p>0</p>
      </FrontOutflow>
      <BackWall>No Slip Wall</BackWall>
      <BackInflow>
        <u>-1</u>
        <v>-1</v>
        <w>-1</w>
      </BackInflow>
      <BackOutflow>
        <p>0</p>
      </BackOutflow>
    </BoundaryConditions>
    <ParallelizationProperties>
      <numProcs>4</numProcs>
      <numProcsX>-1</numProcsX>
      <numProcsY>-1</numProcsY>
      <numProcsZ>-1</numProcsZ>
    </ParallelizationProperties>
    <SolverProperties>
      <IncludeConvectionEffects>True</IncludeConvectionEffects>
      <ConvectionScheme>Upwind</ConvectionScheme>
      <IncludeViscousEffects>True</IncludeViscousEffects>
      <ViscousScheme>CentralDifference</ViscousScheme>
      <TimeIntegrationOrder>1</TimeIntegrationOrder>
      <IncludePressureEffects>False</IncludePressureEffects>
    </SolverProperties>
    <OutputProperties>
      <CheckpointFormat>CSV</CheckpointFormat>
      <StreamFrequency>-1</StreamFrequency>
      <CheckpointFrequency>-1</CheckpointFrequency>
    </OutputProperties>
  </Simulation>
